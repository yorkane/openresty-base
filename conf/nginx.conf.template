# OpenResty Authz Gateway 配置模板
# 由 docker-entrypoint.sh 用 envsubst 生成 nginx.conf
# 变量: HTTP_PORT HTTPS_PORT CERT_FILE CERT_KEY

worker_processes auto;
# 容器内以 root 运行 worker, 保证挂载卷中的 SQLite 可写
user root;
error_log /usr/local/openresty/nginx/logs/error.log warn;
pid       logs/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    # resty.authz 库路径 (LUA_PATH 已含, 此处显式兜底)
    lua_package_path "/usr/local/openresty/lualib/?.lua;/usr/local/openresty/lualib/?/init.lua;;";

    lua_shared_dict authz_cache 5m;

    init_by_lua_block {
        require("resty.authz").init()
    }

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # ── HTTP 入口 → 本机 http 服务 ────────────────────────────────
    server {
        listen ${HTTP_PORT};
        server_name _;

        location /_authz {
            default_type text/html;
            content_by_lua_block {
                require("resty.authz.app").handle()
            }
        }

        location / {
            set $authz_target "";
            set $authz_user   "";
            access_by_lua_block {
                require("resty.authz").access()
            }
            proxy_pass $authz_target;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Authz-User      $authz_user;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
        }
    }

    # ── HTTPS 入口 → 本机 https 服务 ──────────────────────────────
    server {
        listen ${HTTPS_PORT} ssl;
        server_name _;

        ssl_certificate     ${CERT_FILE};
        ssl_certificate_key ${CERT_KEY};
        ssl_protocols TLSv1.2 TLSv1.3;

        location /_authz {
            default_type text/html;
            content_by_lua_block {
                require("resty.authz.app").handle()
            }
        }

        location / {
            set $authz_target "";
            set $authz_user   "";
            access_by_lua_block {
                require("resty.authz").access()
            }
            proxy_pass $authz_target;
            proxy_http_version 1.1;
            proxy_ssl_verify off;          # 本机自签服务不校验证书
            proxy_ssl_server_name on;
            proxy_ssl_name $host;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Authz-User      $authz_user;
            proxy_set_header Upgrade           $http_upgrade;
            proxy_set_header Connection        $connection_upgrade;
        }
    }
}
