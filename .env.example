AUTHZ_HOST_URL=https://your-public-host.example
AUTHZ_COOKIE_DOMAIN=.example.com
# ── 管理员 ──────────────────────────────────────────────
# 首次启动 seed 的 admin 密码 (仅 users 表为空时生效; 登录后请立即改密)
AUTHZ_ADMIN_PASSWORD=change-me-strong-password

# ── 网络 ────────────────────────────────────────────────
# Nginx worker 数量，默认 4；按 CPU 核数和连接数调整。
NGINX_WORKER_PROCESSES=4
# 入口端口: 6080/6443 均代理本机 http 服务 (6443 在网关终止 TLS)
AUTHZ_HTTP_PORT=6080
AUTHZ_HTTPS_PORT=6443

# 数字前缀子域名允许的端口范围 (如 3000-foo.example.com → 本机3000)
AUTHZ_PORT_MIN=2000
AUTHZ_PORT_MAX=20000
# Docker Desktop 无法从容器监听表发现时，追加探测端口，例如 3080,8082
AUTHZ_DISCOVERY_PORTS=
# WebSocket 按域名绑定单独配置：管理端“新增域名绑定”中开启 WebSocket，
# 不使用全局环境变量，避免普通 HTTP 域名意外转发升级请求。

# 管理菜单发现本机 HTTP 服务的缓存与探测超时
AUTHZ_DISCOVERY_TTL=30
AUTHZ_DISCOVERY_CONNECT_TIMEOUT_MS=100
AUTHZ_DISCOVERY_READ_TIMEOUT_MS=200
AUTHZ_DB_CACHE_TTL=30
AUTHZ_DB_CACHE_LRU_SIZE=500

# ── 存储 ────────────────────────────────────────────────
# 宿主机数据目录 (SQLite 数据库 + 自签证书), 必须持久化
DATA_DIR=./data

# 宿主机管理前端目录 (只读挂载，修改前端后刷新浏览器即可，无需重建镜像)
ADMIN_UI_DIR=./admin

# 宿主机项目 Lua 库目录 (只读挂载，与镜像内 site/lualib 完全一致)
LUALIB_DIR=./lualib

# SQLite 文件路径 (容器内)
AUTHZ_DB_PATH=/data/authz/authz.db
# 自签证书目录 (容器内, 缺失时自动生成 10 年期证书)
AUTHZ_CERT_DIR=/data/certs

# ── 会话 ────────────────────────────────────────────────
# 会话有效期 (秒), 默认 7 天
AUTHZ_SESSION_TTL=86400
# 生产入口始终为 HTTPS（包括 TLS 在上游终止且不透传协议头）时设为 true。
AUTHZ_COOKIE_SECURE=true
# 动态端口 iframe 跨子域共享会话时设置，例如 .example.com；本地 localhost 留空。
AUTHZ_COOKIE_DOMAIN=.example.com



AUTHZ_DINGTALK_ENABLED=false
AUTHZ_DINGTALK_CLIENT_ID=your-dingtalk-client-id
AUTHZ_DINGTALK_CLIENT_SECRET=your-dingtalk-client-secret
AUTHZ_DINGTALK_REDIRECT_URI=https://your-public-host.example/_authz/oauth/callback
AUTHZ_DINGTALK_DEFAULT_ROLES=viewer

AUTHZ_NOCO_API_KEY=your-nocobase-api-key
AUTHZ_NOCO_URL=https://your-nocobase-host.example/

# NocoBase OAuth Client（由 scripts/register_nocobase_oauth.py 管理）
AUTHZ_NOCO_OAUTH_ENABLED=true
AUTHZ_NOCO_OAUTH_CLIENT_ID=your-nocobase-oauth-client-id
AUTHZ_NOCO_OAUTH_CLIENT_SECRET=your-nocobase-oauth-client-secret
AUTHZ_NOCO_OAUTH_REDIRECT_URI=https://your-public-host.example/_authz/oauth/callback


AUTHZ_GOOGLE_ENABLED=true
AUTHZ_GOOGLE_CLIENT_ID=your-google-client-id
AUTHZ_GOOGLE_CLIENT_SECRET=your-google-client-secret
AUTHZ_GOOGLE_REDIRECT_URI=https://your-public-host.example/_authz/oauth/callback
AUTHZ_GOOGLE_DEFAULT_ROLES=viewer

# ── 多实例 OAuth 两级中继 ────────────────────────────────
# 架构: 认证实例(中枢)与 Google/钉钉/NocoBase 等身份提供方通信；
# 业务实例把认证请求转发给中枢, 中枢签发 HMAC 断言后跳回业务实例,
# 业务实例验证断言、同步远程身份并创建本机会话。
# 两个实例必须共享同一个 AUTHZ_OAUTH_RELAY_SECRET。

# 认证实例(中枢)配置: 允许哪些业务实例作为中继客户端。
# 格式: 名称|业务实例的 OAuth callback 完整地址, 多个用逗号分隔。
# 名称必须与业务实例的 AUTHZ_OAUTH_RELAY_NAME 一致。
AUTHZ_OAUTH_RELAY_SECRET=change-me-64-hex-random-secret
AUTHZ_OAUTH_RELAY_CLIENTS=business1|https://app1.example.com/_authz/oauth/callback,business2|https://app2.example.com/_authz/oauth/callback

# 业务实例配置: 指向认证实例(中枢)的中继入口。
# AUTHZ_OAUTH_RELAY_NAME 必须出现在中枢的 AUTHZ_OAUTH_RELAY_CLIENTS 白名单中。
# AUTHZ_OAUTH_HUB_PROVIDERS 声明中枢提供的身份提供方, 格式: id[:显示名称], 多个用逗号分隔。
AUTHZ_OAUTH_HUB_URL=https://auth.example.com
AUTHZ_OAUTH_RELAY_NAME=business1
AUTHZ_OAUTH_HUB_PROVIDERS=google,detail:钉钉,nocobase:NocoBase
# 中继断言有效期(秒), 默认 300; 建议 ≤ 身份提供方授权码有效期。
AUTHZ_OAUTH_RELAY_TTL=300
# 仅内网测试允许 http 中枢; 生产必须使用 https。
AUTHZ_OAUTH_RELAY_ALLOW_HTTP=false
