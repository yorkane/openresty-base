# openresty-base Authz Gateway 环境变量配置
# 用法: cp .env.example .env && 编辑后 docker compose up -d

# ── 管理员 ──────────────────────────────────────────────
# 首次启动 seed 的 admin 密码 (仅 users 表为空时生效; 登录后请立即改密)
AUTHZ_ADMIN_PASSWORD=change-me-strong-password

# ── 网络 ────────────────────────────────────────────────
# Nginx worker 数量，默认 4；按 CPU 核数和连接数调整。
NGINX_WORKER_PROCESSES=4

# 浏览器访问网关的公网 Origin，用于生成 OAuth 回调地址，不含末尾斜杠。
AUTHZ_HOST_URL=https://gateway.example.com

# 入口端口: 6080 代理本机 http 服务, 6443 代理本机 https 服务
AUTHZ_HTTP_PORT=6080
AUTHZ_HTTPS_PORT=6443

# 数字前缀子域名允许的端口范围 (如 3000-foo.example.com → 本机3000)
AUTHZ_PORT_MIN=2000
AUTHZ_PORT_MAX=20000

# ── 存储 ────────────────────────────────────────────────
# 宿主机数据目录 (SQLite 数据库 + 自签证书), 必须持久化
DATA_DIR=./data

# 宿主机管理前端目录 (只读挂载，修改前端后刷新浏览器即可，无需重建镜像)
ADMIN_UI_DIR=./admin

# 宿主机项目 Lua 库目录 (只读挂载，与镜像内 site/lualib 完全一致)
LUALIB_DIR=./lualib

# SQLite 文件路径 (容器内)
AUTHZ_DB_PATH=/data/authz/authz.db
# 自签证书目录 (容器内, 缺失时自动生成 10 年期证书)
AUTHZ_CERT_DIR=/data/certs

# ── 会话 ────────────────────────────────────────────────
# 会话有效期 (秒), 默认 7 天
AUTHZ_SESSION_TTL=604800

# 生产入口始终为 HTTPS（包括 TLS 在上游终止且不透传协议头）时设为 true。
AUTHZ_COOKIE_SECURE=false
# 动态端口 iframe 跨子域共享会话时设置，例如 .example.com；本地 localhost 留空。
AUTHZ_COOKIE_DOMAIN=

# 单 IP 登录失败限流：窗口秒数内最多尝试次数；成功登录后清零。
AUTHZ_LOGIN_ATTEMPTS=10
AUTHZ_LOGIN_WINDOW=60

# ── NocoBase 远程身份源 ───────────────────────────────────
# 默认关闭。开启后，可在密码登录表单中显式选择 NocoBase。
# NocoBase JWT 和用户密码不会写入本地数据库；本机只保存用户名、映射角色和会话。
AUTHZ_NOCO_ENABLED=false
AUTHZ_NOCO_URL=https://noco.example.com

# 远程角色映射到本地固定角色 admin/staff/user/viewer，逗号分隔 source=target。
# 未映射角色不会获得本地权限。
AUTHZ_NOCO_ROLE_MAP=root=admin,admin=admin,staff=staff,member=user,user=user,viewer=viewer

# 上游超时（毫秒）
AUTHZ_NOCO_CONNECT_TIMEOUT_MS=3000
AUTHZ_NOCO_SEND_TIMEOUT_MS=5000
AUTHZ_NOCO_READ_TIMEOUT_MS=5000

# ── NocoBase OAuth 2.1 / OIDC 登录 ───────────────────────
# NocoBase 2.2 使用内置 @nocobase/plugin-idp-oauth。首次配置时填写具有
# oidcStates list/create 权限的 API Key，并运行：
# python3 scripts/register_nocobase_oauth.py
# 脚本通过 oidcStates collection API 注册标准 Web Client，并把下列运行时凭据写回 .env。
# AUTHZ_NOCO_API_KEY 只用于一次性注册，不会由 docker-compose 注入网关容器。
AUTHZ_NOCO_API_KEY=
AUTHZ_NOCO_OAUTH_ENABLED=false
AUTHZ_NOCO_OAUTH_TITLE=NocoBase
AUTHZ_NOCO_OAUTH_CLIENT_ID=
AUTHZ_NOCO_OAUTH_CLIENT_SECRET=
AUTHZ_NOCO_OAUTH_REDIRECT_URI=https://gateway.example.com/_authz/oauth/callback
AUTHZ_NOCO_OAUTH_DEFAULT_ROLES=viewer

# ── Google 身份登录（OAuth2 / OIDC）───────────────────────
# 在 Google Cloud Console 创建 Web application OAuth client，并把下面的回调地址
# 精确加入 Authorized redirect URIs。首次登录默认 viewer，管理员可在用户管理中覆盖。
AUTHZ_GOOGLE_ENABLED=false
AUTHZ_GOOGLE_CLIENT_ID=
AUTHZ_GOOGLE_CLIENT_SECRET=
AUTHZ_GOOGLE_REDIRECT_URI=https://gateway.example.com/_authz/oauth/callback
AUTHZ_GOOGLE_DEFAULT_ROLES=viewer

# ── 钉钉身份登录 ──────────────────────────────────────────
# 钉钉开放平台创建应用并启用“钉钉登录与分享”，回调地址必须与后台完全一致。
AUTHZ_DINGTALK_ENABLED=false
AUTHZ_DINGTALK_CLIENT_ID=
AUTHZ_DINGTALK_CLIENT_SECRET=
AUTHZ_DINGTALK_REDIRECT_URI=https://gateway.example.com/_authz/oauth/callback
AUTHZ_DINGTALK_DEFAULT_ROLES=viewer

# ── 微信开放平台网站应用登录 ──────────────────────────────
# 需要已审核的网站应用和“微信登录”能力，不是公众号网页授权或小程序登录。
AUTHZ_WECHAT_ENABLED=false
AUTHZ_WECHAT_APP_ID=
AUTHZ_WECHAT_APP_SECRET=
AUTHZ_WECHAT_REDIRECT_URI=https://gateway.example.com/_authz/oauth/callback
AUTHZ_WECHAT_DEFAULT_ROLES=viewer

# ── 通用 OAuth2 / OIDC 身份登录 ───────────────────────────
# 使用 Authorization Code + PKCE，并通过 userinfo 端点读取 subject/username/roles。
AUTHZ_OAUTH_ENABLED=false
AUTHZ_OAUTH_PROVIDER=company
AUTHZ_OAUTH_TITLE=Company SSO
AUTHZ_OAUTH_CLIENT_ID=
AUTHZ_OAUTH_CLIENT_SECRET=
AUTHZ_OAUTH_AUTHORIZE_URL=https://id.example.com/oauth2/authorize
AUTHZ_OAUTH_TOKEN_URL=https://id.example.com/oauth2/token
AUTHZ_OAUTH_USERINFO_URL=https://id.example.com/oauth2/userinfo
AUTHZ_OAUTH_REDIRECT_URI=https://gateway.example.com/_authz/oauth/callback
AUTHZ_OAUTH_SCOPE=openid email profile
AUTHZ_OAUTH_SUBJECT_CLAIM=sub
AUTHZ_OAUTH_USERNAME_CLAIM=email
AUTHZ_OAUTH_ROLE_CLAIM=roles
AUTHZ_OAUTH_ROLE_MAP=admins=admin,employees=staff,members=user,guests=viewer
AUTHZ_OAUTH_DEFAULT_ROLES=viewer
AUTHZ_OAUTH_REQUIRE_VERIFIED_EMAIL=false
AUTHZ_OAUTH_STATE_TTL=600
AUTHZ_OAUTH_CONNECT_TIMEOUT_MS=10000
AUTHZ_OAUTH_SEND_TIMEOUT_MS=10000
AUTHZ_OAUTH_READ_TIMEOUT_MS=15000

# 默认自动读取容器 /etc/resolv.conf；仅在生产 DNS 有特殊要求时覆盖。
AUTHZ_DNS_RESOLVER=
